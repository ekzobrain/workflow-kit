grammar FEEL

  #
  # Entry point for literal expressions.
  #
  # A simple positive unary test (e.g. `< 10`, `[1..5]`) is also accepted as a
  # textual expression (2.i) and is evaluated against the input value `?`.
  #
  rule start
    __ expr:expression __ !. <Root> /
    __ expr:simple_positive_unary_test __ !. <UnaryTestRoot>
  end

  #
  # Entry point for unary tests (decision table input entries).
  #
  # 17. unary tests =
  # 17.a positive unary tests |
  # 17.b "not", " (", positive unary tests, ")" |
  # 17.c "-"
  #
  rule unary_tests
    __ "-" __ !. <AnyUnaryTest> /
    __ "not" __ "(" __ tests:positive_unary_tests __ ")" __ !. <NegatedUnaryTests> /
    __ tests:positive_unary_tests __ !. <UnaryTestsRoot>
  end

  #
  # 16. positive unary tests = positive unary test , { "," , positive unary test } ;
  #
  rule positive_unary_tests
    head:positive_unary_test tail:(__ "," __ positive_unary_test)* <PositiveUnaryTests>
  end

  #
  # 15. positive unary test = expression ;
  #
  rule positive_unary_test
    simple_positive_unary_test /
    expr:expression <ExpressionUnaryTest>
  end

  #
  # 7. simple positive unary test =
  # 7.a [ "<" | "<=" | ">" | ">=" ] , endpoint |
  # 7.b interval ;
  #
  rule simple_positive_unary_test
    operator:unary_operator __ endpoint <UnaryComparison> /
    interval
  end

  rule unary_operator
    "<=" / ">=" / "<" / ">"
  end

  #
  # 18. endpoint = simple value ;
  #
  # Note: any arithmetic expression is accepted as an endpoint.
  #
  rule endpoint
    additive
  end

  #
  # 8. interval = ( open interval start | closed interval start ) , endpoint , ".." , endpoint , ( open interval end | closed interval end ) ;
  # 9. open interval start = "(" | "]" ;
  # 10. closed interval start = "[" ;
  # 11. open interval end = ")" | "[" ;
  # 12. closed interval end = "]" ;
  #
  rule interval
    start_token:("(" / "]" / "[") __ low:endpoint __ ".." __ high:endpoint __ end_token:(")" / "[" / "]") <Interval>
  end

  #
  # 1. expression = textual expression | boxed expression ;
  #
  # 2. textual expression =
  # 2.a function definition | for expression | if expression | quantified expression |
  # 2.b disjunction |
  # 2.c conjunction |
  # 2.d comparison |
  # 2.e arithmetic expression |
  # 2.f instance of |
  # 2.g path expression |
  # 2.h filter expression | function invocation |
  # 2.i literal | simple positive unary test | name | "(" , textual expression , ")" ;
  #
  # Operator precedence (lowest to highest):
  #   disjunction > conjunction > comparison / between / in / instance of >
  #   addition, subtraction > multiplication, division > exponentiation >
  #   arithmetic negation > path, filter, invocation > primary
  #
  rule expression
    function_definition /
    for_expression /
    if_expression /
    quantified_expression /
    disjunction
  end

  #
  # 57. function definition = "function" , "(" , [ formal parameter { "," , formal parameter } ] , ")" , [ "external" ] , expression ;
  #
  rule function_definition
    "function" __ "(" __ formal_parameters:formal_parameter_list? __ ")" __ body:expression <FunctionDefinition>
  end

  rule formal_parameter_list
    head:formal_parameter tail:(__ "," __ formal_parameter)* <FormalParameterList>
  end

  #
  # 58. formal parameter = parameter name [":" type ] ;
  #
  rule formal_parameter
    parameter_name type_annotation:(__ ":" __ type_name)? <FormalParameter>
  end

  #
  # 46. for expression = "for" , name , "in" , iteration context { "," , name , "in" , iteration context } , "return" , expression ;
  #
  rule for_expression
    "for" !name_part_char __ head:iteration_context tail:(__ "," __ iteration_context)* __ "return" !name_part_char __ body:expression <ForExpression>
  end

  rule iteration_context
    variable:name __ "in" !name_part_char __ domain:iteration_domain <IterationContext>
  end

  rule iteration_domain
    range /
    expression
  end

  rule range
    low:additive __ ".." __ high:additive <RangeExpression>
  end

  #
  # 47. if expression = "if" , expression , "then" , expression , "else" expression ;
  #
  rule if_expression
    "if" !name_part_char __ condition:expression __ "then" !name_part_char __ true_case:expression __ "else" !name_part_char __ false_case:expression <IfExpression>
  end

  #
  # 48. quantified expression = ("some" | "every") , name , "in" , expression , { name , "in" , expression } , "satisfies" , expression ;
  #
  rule quantified_expression
    quantifier:("some" / "every") !name_part_char __ head:iteration_context tail:(__ ","? __ iteration_context)* __ "satisfies" !name_part_char __ condition:expression <QuantifiedExpression>
  end

  #
  # 49. disjunction = expression , "or" , expression ;
  #
  rule disjunction
    head:conjunction tail:(__ "or" !name_part_char __ operand:conjunction)+ <Disjunction> /
    conjunction
  end

  #
  # 50. conjunction = expression , "and" , expression ;
  #
  rule conjunction
    head:comparison tail:(__ "and" !name_part_char __ operand:comparison)+ <Conjunction> /
    comparison
  end

  #
  # 51. comparison =
  # 51.a expression , ( "=" | "!=" | "<" | "<=" | ">" | ">=" ) , expression |
  # 51.b expression , "between" , expression , "and" , expression |
  # 51.c expression , "in" , positive unary test ;
  # 51.d expression , "in" , " (", positive unary tests, ")" ;
  #
  # 53. instance of = expression , "instance" , "of" , type ;
  #
  rule comparison
    left:additive __ operator:comparison_operator __ right:additive <Comparison> /
    value:additive __ "between" !name_part_char __ low:additive __ "and" !name_part_char __ high:additive <Between> /
    value:additive __ "in" !name_part_char __ "(" __ tests:positive_unary_tests __ ")" <InExpression> /
    value:additive __ "in" !name_part_char __ tests:in_positive_unary_test <InExpression> /
    value:additive __ "instance" !name_part_char __ "of" !name_part_char __ type:type_name <InstanceOf> /
    additive
  end

  rule in_positive_unary_test
    simple_positive_unary_test /
    expr:comparison <ExpressionUnaryTest>
  end

  rule comparison_operator
    "!=" / "<=" / ">=" / "=" / "<" / ">"
  end

  #
  # 54. type = qualified name ;
  #
  rule type_name
    ("date and time" / "years and months duration" / "days and time duration") !name_part_char /
    ("function" !name_part_char / identifier) (__ "<" __ type_name (__ "," __ type_name)* __ ">")?
  end

  #
  # 4. arithmetic expression =
  # 4.a addition | subtraction |
  # 4.b multiplication | division |
  # 4.c exponentiation |
  # 4.d arithmetic negation ;
  #
  # 21. addition = expression , "+" , expression ;
  # 22. subtraction = expression , "-" , expression ;
  #
  rule additive
    head:multiplicative tail:(__ operator:("+" / "-") __ operand:multiplicative)+ <Addition> /
    multiplicative
  end

  #
  # 23. multiplication = expression , "*" , expression ;
  # 24. division = expression , "/" , expression ;
  #
  rule multiplicative
    head:exponentiation tail:(__ operator:("*" !"*" / "/" !("/" / "*")) __ operand:exponentiation)+ <Multiplication> /
    exponentiation
  end

  #
  # 25. exponentiation = expression, "**", expression ;
  #
  # Note: left-associative like feel-scala, i.e. `2**2**3` = `(2**2)**3` = 64.
  #
  rule exponentiation
    head:negation tail:(__ "**" __ operand:negation)+ <Exponentiation> /
    negation
  end

  #
  # 26. arithmetic negation = "-" , expression ;
  #
  rule negation
    "-" __ operand:negation <ArithmeticNegation> /
    postfix
  end

  #
  # 45. path expression = expression , "." , name ;
  # 52. filter expression = expression , "[" , expression , "]" ;
  # 40. function invocation = expression , parameters ;
  #
  rule postfix
    head:primary tail:postfix_operation+ <PostfixExpression> /
    primary
  end

  rule postfix_operation
    __ "[" __ filter_expression:expression __ "]" <FilterOperation> /
    __ "." __ property:property_name <PathOperation> /
    "(" __ params:parameters? __ ")" <InvocationOperation>
  end

  rule property_name
    "time offset" !name_part_char /
    name
  end

  rule primary
    literal /
    list /
    context /
    "(" __ expr:expression __ ")" <Parenthesized> /
    function_invocation /
    input_value /
    qualified_name
  end

  rule input_value
    "?" <InputValue>
  end

  #
  # 40. function invocation = expression , parameters ;
  #
  rule function_invocation
    fn_name:function_name __ "(" __ params:parameters? __ ")" <FunctionInvocation>
  end

  rule function_name
    ("date and time" / "years and months duration" / "get or else" / "and" / "or") !name_part_char /
    multi_word_name /
    qualified_name
  end

  #
  # 41. parameters = "(" , ( named parameters | positional parameters ) , ")" ;
  #
  rule parameters
    named_parameters /
    positional_parameters
  end

  #
  # 42. named parameters = parameter name , ":" , expression , { "," , parameter name , ":" , expression } ;
  #
  rule named_parameters
    head:named_parameter tail:(__ "," __ named_parameter)* <NamedParameters>
  end

  rule named_parameter
    parameter_name __ ":" __ value:argument <NamedParameter>
  end

  #
  # 43. parameter name = name ;
  #
  rule parameter_name
    multi_word_name /
    name
  end

  #
  # 44. positional parameters = [ expression , { "," , expression } ] ;
  #
  rule positional_parameters
    head:argument tail:(__ "," __ argument)* <PositionalParameters>
  end

  #
  # A function argument: an expression, or a range value (e.g. `[1..10]`,
  # `(1..10]`, `]1..10[`, `< 10`) as in `before(1, [2..5])`.
  #
  rule argument
    range_literal /
    expression
  end

  #
  # Range literal (DMN 1.4 "range"), only allowed as a function argument.
  # Elsewhere, an interval is a simple positive unary test.
  #
  rule range_literal
    start_token:("(" / "]" / "[") __ low:endpoint __ ".." __ high:endpoint __ end_token:(")" / "[" / "]") <RangeLiteral> /
    operator:unary_operator __ endpoint <OpenRangeLiteral>
  end

  #
  # 20. qualified name = name , { "." , name } ;
  #
  rule qualified_name
    head:name tail:(__ "." __ name)* <QualifiedName>
  end

  #
  # 27. name = name start , { name part | additional name symbols } ;
  #
  # Note: names with whitespace are only allowed for function names, parameter
  # names and context keys. Any other name can be escaped with backticks.
  #
  rule name
    backtick_name /
    identifier
  end

  rule identifier
    !(reserved_word !name_part_char) name_start_char name_part_char* <Name>
  end

  rule multi_word_name
    identifier (" "+ identifier)+ <Name>
  end

  rule backtick_name
    "`" content:(!"`" .)+ "`" <BacktickName>
  end

  rule reserved_word
    "null" / "true" / "false" / "function" / "in" / "return" / "then" / "else" /
    "satisfies" / "and" / "or" / "between" / "instance"
  end

  #
  # 30. name start char = "?" | [A-Z] | "_" | [a-z] | [\uC0-\uD6] | [\uD8-\uF6] | [\uF8-\u2FF] | [\u370-\u37D] | [\u37F-῿] | [‌-‍] | [⁰-↏] | [Ⰰ-⿯] | [、-퟿] | [豈-﷏] | [ﷰ-�] | [က0-F] ;
  #
  rule name_start_char
    [A-Za-z_À-ÖØ-öø-˿Ͱ-ͽͿ-ᙿᚁ-᠍᠏-῿‌-‍⁰-↏Ⰰ-⿯、-퟿豈-﷏ﷰ-﻾＀-�]
  end

  #
  # 31. name part char = name start char | digit | \uB7 | [̀-ͯ] | [‿-⁀] ;
  #
  rule name_part_char
    name_start_char /
    [0-9·̀-ͯ‿-⁀]
  end

  #
  # 33. literal = simple literal | "null" ;
  # 34. simple literal = numeric literal | string literal | boolean literal | date time literal ;
  #
  rule literal
    numeric_literal /
    string_literal /
    boolean_literal /
    null_literal /
    at_literal
  end

  rule at_literal
    "@" string_literal <AtLiteral>
  end

  #
  # 35. string literal = '"' , { character - ('"' | vertical space) }, '"' ;
  #
  rule string_literal
    '"' chars:double_string_character* '"' <StringLiteral> /
    "'" chars:single_string_character* "'" <StringLiteral>
  end

  rule double_string_character
    !('"' / "\\") . /
    "\\" escape_sequence
  end

  rule single_string_character
    !("'" / "\\") . /
    "\\" escape_sequence
  end

  # Any character can follow a backslash: known escape sequences are
  # translated, any other one (e.g. regex characters like \d) is kept as is.
  rule escape_sequence
    "u" [0-9a-fA-F] 4..4 /
    .
  end

  rule line_terminator
    "\r\n" / "\n" / "\r"
  end

  #
  # 36. Boolean literal = "true" | "false" ;
  #
  rule boolean_literal
    ("true" / "false") !name_part_char <BooleanLiteral>
  end

  rule null_literal
    "null" !name_part_char <NullLiteral>
  end

  #
  # 37. numeric literal = [ "-" ] , ( digits , [ ".", digits ] | "." , digits ) ;
  #
  # Note: the sign is handled by the arithmetic negation.
  #
  rule numeric_literal
    [0-9]+ ("." [0-9]+)? <NumericLiteral> /
    "." [0-9]+ <NumericLiteral>
  end

  #
  # 56. list = "[" [ expression , { "," , expression } ] , "]" ;
  #
  rule list
    "[" __ head:expression tail:(__ "," __ expression)* __ "]" <List> /
    "[" __ "]" <List>
  end

  #
  # 59. context = "{" , [context entry , { "," , context entry } ] , "}" ;
  #
  rule context
    "{" __ head:context_entry tail:(__ "," __ context_entry)* __ ","? __ "}" <ContextLiteral> /
    "{" __ "}" <ContextLiteral>
  end

  #
  # 60. context entry = key , ":" , expression ;
  #
  rule context_entry
    key:context_key __ ":" __ value:expression <ContextEntry>
  end

  #
  # 61. key = name | string literal ;
  #
  rule context_key
    string_literal /
    backtick_name /
    (!["{}:,\[\]`] .)+ <ContextKey>
  end

  #
  # Whitespace and comments (single-line `//` and multi-line `/* */`).
  #
  rule __
    (white_space / comment)*
  end

  rule white_space
    [\s\u0085  ᠎ -​    　﻿]
  end

  rule comment
    "//" (!line_terminator .)* /
    "/*" (!"*/" .)* "*/"
  end
end
